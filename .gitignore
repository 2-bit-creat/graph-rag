# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.log

# Local Postgres / infra data
pgdata/
minio_data/
backend/uploads/
backend/debug_runs/
# Runtime artifacts written to the repo root when the backend runs from here
# (per-user audio + file stores, pipeline traces) — local only, never tracked.
uploads/
debug_runs/

# Codex/editor scratch app-data
.codex-dart-appdata/
.claude/settings.local.json

# Local agent handoff notes (may contain environment-specific evaluation details)
HANDOFF_quiz_quality.md

# Flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins-dependencies

# SAM build artifacts (local Docker layer cache + packaged template)
.aws-sam/

# Env files
.env
.env.local
.env*.local

# Backend deploy secrets (real DatabaseUrl/OpenAiApiKey/JwtSecret) — see
# .deploy-secrets.env.example for the template.
.deploy-secrets.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Scratch / scratch test artifacts (not part of the app)
backend/_*.json
backend/py
backend/sample.json
backend/test_audio_ko.mp3

# Generated runtime audio (quiz TTS output); keep the dir via .gitkeep
backend/static/audio/*.mp3

# Golden-test diff artifacts (regenerated on every failing run)
mobile/test/failures/

# Android Gradle build output
mobile/android/build/

# Golden screenshots are generated locally, never committed: they render real
# journal content and this repo is public. Regenerate with
#   QUIZ_SHOT_FONT_DIR=<ttf dir> flutter test <suite> --update-goldens
mobile/test/screenshots/

# Database dumps and migration reports. These hold the graph verbatim — real
# names of everyone the diaries mention — and this repo is public. The
# Person→Identity report in particular is the only record of which identities
# used to carry that type, so keep it locally, never here.
backups/
